APP_HOST=127.0.0.1
APP_PORT=8000
# development: DATABASE_URL may be omitted and APP_DB_PATH is used.
# production: a postgresql:// URL is mandatory. Inject the password through the
# deployment secret environment; never commit a populated URL.
APP_ENV=development
DATABASE_URL=
APP_DB_PATH=var/public_restaurant.db

NAVER_MAP_KEY=
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
NAVER_LOGIN_REDIRECT_URI=http://127.0.0.1:8000/auth/callback/naver

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/callback/google

DATA_GO_KR_SERVICE_KEY=
REVIEW_RATE_LIMIT_PER_HOUR=3
