APP_HOST=127.0.0.1
APP_PORT=8000
# PostgreSQL is mandatory in every environment. Inject passwords through the
# environment or secret store; never commit a populated credential URL.
APP_ENV=development
DATABASE_URL=postgresql://restaurant_app@127.0.0.1:5432/public_restaurant_dev
# Optional explicit isolated test database. If omitted, tests derive a database
# name ending in _test from DATABASE_URL. The database must already exist.
TEST_DATABASE_URL=postgresql://restaurant_app@127.0.0.1:5432/public_restaurant_dev_test
RESTAURANT_IMAGE_UPLOAD_DIR=var/restaurant_images
# Optional dedicated session signing key. If omitted, the login provider secret
# is used with a separate derived signing key.
APP_SESSION_SECRET=
# Public contact shown in the privacy policy and terms. Required in production.
PRIVACY_CONTACT_EMAIL=

NAVER_MAP_KEY=
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# Preferred for new Naver Image Search integrations.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
NAVER_LOGIN_REDIRECT_URI=http://127.0.0.1:8000/auth/callback/naver

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/callback/google

DATA_GO_KR_SERVICE_KEY=

# Optional. AI review summaries are cached in the database and are generated
# first at 5 public reviews, then after each 10 additional reviews, at most once
# per hour.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Admin dashboard free-tier reference values. Adjust these when the provider
# changes your account's quota or plan.
NAVER_SEARCH_DAILY_QUOTA=25000
NAVER_API_HUB_MONTHLY_QUOTA=775000
DATA_GO_KR_DAILY_QUOTA=10000
GROQ_DAILY_QUOTA=1000

REVIEW_RATE_LIMIT_PER_HOUR=3
